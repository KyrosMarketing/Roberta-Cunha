<script>
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  // Blocos coerentes em vez de animar cada linha de texto separadamente.
  const targets = document.querySelectorAll<HTMLElement>(
    'main .section-heading, main .service-card, main .detail-row, main .about-visual, main .about-copy, main .steps, main .faq-intro, main .faq-list, main .contact-grid, main .closing',
  );
  const seen = new WeakSet<Element>();
  let observer: IntersectionObserver | undefined;
  const reveal = (target: HTMLElement, immediate = false) => {
    seen.add(target);
    observer?.unobserve(target);
    if (immediate) target.removeAttribute('data-reveal');
    else target.dataset.reveal = 'visible';
  };
  const setup = () => {
    observer?.disconnect();
    if (preference.matches || !('IntersectionObserver' in window)) {
      targets.forEach((target) => reveal(target, true));
      return;
    }
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) reveal(entry.target as HTMLElement);
        });
      },
      { threshold: 0, rootMargin: '120px 0px' },
    );
    // Uma medição inicial, sem listeners ou cálculos durante o scroll.
    targets.forEach((target) => {
      if (
        seen.has(target) ||
        target.getBoundingClientRect().top < innerHeight + 120
      ) {
        reveal(target, true);
        return;
      }
      target.dataset.reveal = 'pending';
      observer?.observe(target);
    });
  };
  document.addEventListener('focusin', (event) => {
    const target = (event.target as Element).closest<HTMLElement>(
      '[data-reveal="pending"]',
    );
    if (target) reveal(target, true);
  });
  preference.addEventListener('change', setup);
  setup();
</script>
