---
import { site, whatsapp } from '../data/site';
---

<footer>
  <div class="container footer-grid">
    <div class="footer-identity">
      <a class="footer-brand" href="/#inicio">
        {site.assets.logo ? (
          <img
            src={site.assets.logo.src}
            alt={site.assets.logo.alt}
            width={site.assets.logo.width}
            height={site.assets.logo.height}
          />
        ) : (
          site.name
        )}
      </a>
      <p>
        {site.fullName}
        <br />
        Psicóloga · CRP {site.crp}
      </p>
    </div>
    <div class="footer-info">
      <p class="eyebrow">CONSULTÓRIO NO BATEL</p>
      <address>{site.address}</address>
      <nav class="footer-contacts" aria-label="Contatos da Roberta">
        <a class="footer-email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <span class="footer-phone">
          <a
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
            data-contact
            aria-label="Conversar com Roberta pelo WhatsApp (nova aba)"
          >
            WhatsApp
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={`tel:+${site.whatsapp}`}
            aria-label={`Ligar para ${site.phone}`}
          >
            {site.phone}
          </a>
        </span>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          Instagram{' '}
          <svg
            class="icon"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M5 19 19 5M5 5h14v14" />
          </svg>
        </a>
      </nav>
    </div>
  </div>
  <div class="container footer-meta">
    <nav class="footer-legal" aria-label="Privacidade e cookies">
      <a href="/politica-de-privacidade/">Política de Privacidade</a>
      <a href="/politica-de-cookies/">Política de Cookies</a>
      <button class="text-button" data-cookie-settings>
        Preferências de cookies
      </button>
    </nav>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {site.name}. Todos os direitos reservados.
      </span>
      <span>Escuta, ciência e cuidado.</span>
    </div>
  </div>
</footer>
