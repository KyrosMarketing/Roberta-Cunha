---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada | Roberta Cunha" noindex>
  <main id="conteudo" class="container legal">
    <p class="eyebrow">404 / PÁGINA NÃO ENCONTRADA</p>
    <h1>
      Vamos encontrar
      <br />
      outro caminho?
    </h1>
    <p>
      O endereço acessado não está disponível. Na página inicial você encontra
      informações sobre os atendimentos e as formas de contato.
    </p>
    <a class="button" href="/">
      Voltar ao início{' '}
      <span aria-hidden="true">
        <svg
          class="icon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M5 19 19 5M5 5h14v14" />
        </svg>
      </span>
    </a>
  </main>
</Layout>
